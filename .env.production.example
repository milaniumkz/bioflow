NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bioflow?schema=public
REDIS_URL=redis://HOST:6379
JWT_ACCESS_SECRET=replace-with-strong-random-value
JWT_REFRESH_SECRET=replace-with-strong-random-value
QR_SIGNING_SECRET=replace-with-strong-random-value
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=bioflow
S3_ACCESS_KEY=replace
S3_SECRET_KEY=replace
WEB_ORIGIN=https://bioflow.example.com
NEXT_PUBLIC_API_URL=https://bioflow.example.com/api/v1

S3_PUBLIC_ENDPOINT=https://s3.example.com
TRANSPORT_OVERDUE_HOURS=24
# Optional push provider; mount the real service account through secrets/, never commit it
FCM_SERVICE_ACCOUNT_FILE=/run/bioflow-secrets/firebase-service-account.json
