NODE_ENV=development
DATABASE_URL=postgresql://bioflow:bioflow@localhost:5432/bioflow?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
QR_SIGNING_SECRET=change-me-qr
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bioflow
S3_ACCESS_KEY=bioflow-local
S3_SECRET_KEY=bioflow-local-development-only
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Browser-visible endpoint when the API runs inside Docker
S3_PUBLIC_ENDPOINT=http://localhost:9000
TRANSPORT_OVERDUE_HOURS=24
